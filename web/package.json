{
  "name": "flipthetable-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:wasm && next dev",
    "build": "npm run build:wasm:release && next build",
    "start": "next start",
    "build:wasm": "wasm-pack build ../crates/game --target web --dev --out-dir ../../web/public/wasm --out-name flipthetable_game",
    "build:wasm:release": "wasm-pack build ../crates/game --target web --release --out-dir ../../web/public/wasm --out-name flipthetable_game"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
